# Faculty Learning Hub — environment template.
# Copy to .env and adjust: cp .env.example .env

# Keep bytecode cache centralized (see README).
PYTHONPYCACHEPREFIX=.cache/python

SECRET_KEY=change-me-in-real-deploy
DEBUG=True
# Comma separated, e.g. localhost,127.0.0.1
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (see docs/adr/001-database-strategy.md — no SQLite fallback)
DB_NAME=faculty_hub
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Google Drive integration (see materials/drive.py). All optional; without them,
# Drive URL validation/normalization still works with no outbound calls and file
# uploads fall back to local disk (zero-network in dev/test).
# API key: enables public file metadata enrichment (Drive API v3).
GOOGLE_DRIVE_API_KEY=
# Service account: base64-encoded JSON key. REQUIRED for uploads to the Shared
# Drive (OAuth2 JWT-bearer token minting).
GOOGLE_DRIVE_SERVICE_ACCOUNT_B64=
# Shared Drive + target folder: when both are set, new uploads go to Google
# Drive instead of local disk. Shared Drive ID is needed for Shared-Drive-aware
# API calls (supportsAllDrives/driveId); folder ID is the upload destination.
GOOGLE_DRIVE_SHARED_DRIVE_ID=
GOOGLE_DRIVE_FOLDER_ID=
